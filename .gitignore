# Node — only used by tools/set-link-domain.mjs (firebase-admin).
# Never commit the installed tree; `npm install` regenerates it from the lockfile.
node_modules/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase service account keys — FULL-ADMIN credentials, never commit.
# Used by tools/set-link-domain.mjs; delete the file once it has run.
tools/service-account.json
**/service-account*.json
*-firebase-adminsdk-*.json
